{
  "name": "mfw-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The MFW admin panel (DEC-004 AGREED): React and TypeScript, built with Vite for Firebase Hosting. Tested against the local emulators.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm --prefix ../backend/functions run build",
    "test": "sh ../backend/scripts/run-with-env.sh ../backend/node_modules/.bin/firebase emulators:exec --config ../backend/firebase.json --only auth,functions,firestore --project demo-mfw \"vitest run\"",
    "test:smoke": "vitest run test/smoke.test.tsx"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
