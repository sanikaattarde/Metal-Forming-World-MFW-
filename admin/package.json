{
  "name": "mfw-admin-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SPIKE (DEC-004 OPEN). The admin panel, against the local emulators only. Not production code and not merged to main.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm --prefix ../backend/spike/functions run build",
    "test": "sh ../backend/spike/scripts/run-with-env.sh ../backend/spike/node_modules/.bin/firebase emulators:exec --config ../backend/spike/firebase.json --only auth,functions,firestore --project demo-mfw-spike \"vitest run\"",
    "test:smoke": "vitest run test/smoke.test.tsx"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
