# Metal Forming World (MFW): configuration example
#
# PLACEHOLDERS ONLY. This file is tracked in a public repository. It names the
# configuration items of DEPLOYMENT_PLAN.md section 5.2 (CFG-01 to CFG-15) and
# holds no real value, secret, credential or personal data. Do not put one here.
#
# How to use it
#   1. Copy this file to config/<environment>.env. Everything in config/ except
#      this example is ignored by Git (.gitignore).
#   2. Fill in the values for that environment from the source named beside
#      each item. The environments are ENV-LOCAL, ENV-TEST and ENV-PROD
#      (DEC-023, AGREED as an internal position; MFW's approval of ENV-TEST
#      is still needed, OQ-40), for example config/local.env.
#   3. The app takes build-time values through --dart-define-from-file
#      (PROPOSED, DEPLOYMENT_PLAN.md section 5.1). Flutter 3.47.9 reads this
#      .env format, comments included (checked on 9 November 2026 with
#      flutter test). No app code reads these values yet.
#      Server-side secrets are never kept in a file. They live in the provider's
#      secret store in MFW's account.
#
# Each entry shows the item, then its status in DEPLOYMENT_PLAN.md. The format
# of this file is a proposal for review and can change.

# The environment this file is for: local, test or prod (DEC-023,
# DEPLOYMENT_PLAN.md section 4). The app reads it as MFW_ENV and uses local
# when it is not set. A prod build stops at start-up if CFG-03, CFG-04 or
# CFG-07 is not set or an address is not HTTPS (MOD01-P2-T04).
MFW_ENV=local

# CFG-01 Backend project identifier for this environment
# Status: OPEN (OQ-40). DEC-003 is AGREED, so this is a Firebase project
# identifier. Comes from MFW's cloud project.
CFG_01_BACKEND_PROJECT_ID=replace-me

# CFG-01, continued: the Firebase app identifiers the app needs (MOD03-P2-T03,
# app/lib/core/config/firebase_settings.dart). Public identifiers, not
# secrets; access is decided by the backend's rules and functions (DEC-009).
# They come from the Firebase console of MFW's project, one app per platform.
# ENV-TEST and ENV-PROD must set all six below; ENV-LOCAL with no project set
# runs against the local emulators under the demo project demo-mfw.
FIREBASE_MESSAGING_SENDER_ID=replace-me
FIREBASE_ANDROID_API_KEY=replace-me
FIREBASE_ANDROID_APP_ID=replace-me
FIREBASE_IOS_API_KEY=replace-me
FIREBASE_IOS_APP_ID=replace-me
# Optional: the project's default bucket.
FIREBASE_STORAGE_BUCKET=replace-me
# ENV-LOCAL only: the emulators' host as the device sees it. Leave it unset
# for the default: 10.0.2.2 on the Android emulator, 127.0.0.1 on iOS.
MFW_EMULATOR_HOST=replace-me

# CFG-02 Cloud region
# Status: OPEN (OQ-41, DEC-031). Cannot be changed later. Comes from MFW's decision.
CFG_02_CLOUD_REGION=replace-me

# CFG-03 WordPress site address
# Status: OPEN (OQ-39). Comes from MFW.
CFG_03_WORDPRESS_SITE_URL=replace-me

# CFG-04 WordPress categories shown in the app
# Status: OPEN (RS INT-WP-003). Comes from MFW.
CFG_04_WORDPRESS_CATEGORIES=replace-me

# CFG-05 Upload size limit
# Status: RS FR-ADMIN-007 gives 150 MB by default. Unit and boundary are OPEN (OQ-30).
CFG_05_UPLOAD_SIZE_LIMIT=replace-me

# CFG-06 Issue-file grant lifetime
# Status: the value is OPEN (OQ-37). DEC-020 is AGREED: function-issued signed
# URLs. The backend reads it as config/private.signed_url_lifetime, in whole
# seconds from 1 to 3600, and refuses the call when it is missing or outside
# that range (backend/README.md). No value is proposed here.
CFG_06_FILE_GRANT_LIFETIME=replace-me

# CFG-07 Privacy policy and terms-of-use addresses
# Status: MFW input (Charter section 12).
CFG_07_PRIVACY_POLICY_URL=replace-me
CFG_07_TERMS_OF_USE_URL=replace-me

# CFG-08 Store links used for sharing
# Status: OPEN (OQ-15). Known only once the apps are listed.
CFG_08_STORE_LINK_ANDROID=replace-me
CFG_08_STORE_LINK_IOS=replace-me

# CFG-09 Google Sign-In client configuration
# Status: OPEN (DEC-006, OQ-42). PROVISIONAL (C-04). Public identifiers only:
# Android package name and signing-certificate fingerprints, iOS bundle ID and URL scheme.
CFG_09_GOOGLE_SIGN_IN_ANDROID_FINGERPRINTS=replace-me
CFG_09_GOOGLE_SIGN_IN_IOS_URL_SCHEME=replace-me

# CFG-10 iOS push credential in MFW's Apple Developer account
# NOT SET IN THIS FILE. It is a credential. It stays in MFW's account and in the
# provider's secret store, and it never goes into Git.

# CFG-11 Crash-reporting and usage-event configuration
# Status: OPEN (DEC-003, OQ-23). Usage events stay off until OQ-23 is answered.
CFG_11_CRASH_REPORTING_ENABLED=replace-me
CFG_11_USAGE_EVENTS_ENABLED=replace-me

# CFG-12 Admin panel address
# Status: OPEN. A custom domain would be at MFW's cost (S1 Costs outside the fee).
CFG_12_ADMIN_PANEL_URL=replace-me

# CFG-13 Notification categories
# Status: OPEN (OQ-18). The working position is three fixed categories set by the developers (GS-Q47).
CFG_13_NOTIFICATION_CATEGORIES=replace-me

# CFG-14 Admin accounts
# NOT SET IN THIS FILE. MFW's admin list holds personal data, so it is never
# stored in Git. The first admin is created by a controlled step (OP-42).

# CFG-15 App name and identifiers
# Status: OPEN (OQ-42). Android application ID and iOS bundle ID.
CFG_15_APP_NAME=replace-me
CFG_15_ANDROID_APPLICATION_ID=replace-me
CFG_15_IOS_BUNDLE_ID=replace-me
