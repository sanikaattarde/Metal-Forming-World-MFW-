# MFW admin panel: build configuration example (CFG-01, DEC-004)
#
# PLACEHOLDERS ONLY. This file is tracked in a public repository. Copy it to
# admin/.env.test or admin/.env.production (ignored by Git) and fill in the web
# configuration of that environment's Firebase project, from the Firebase
# console of MFW's project. The web configuration identifies the project and is
# not a secret; no secret ever goes in a file here.
#
# Leave all three unset to build a panel that runs only against the local
# emulators. Set all three or none: a partial configuration stops the panel.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Optional.
VITE_FIREBASE_APP_ID=
